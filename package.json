{
  "name": "te-one",
  "version": "0.1.0",
  "private": true,
  "description": "TE One — Enterprise Customer Relationship Management Platform (Trilogika Edutama)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tahap1": "vitest run -t @tahap-1",
    "test:report": "node scripts/run-test-report.mjs",
    "e2e": "node -e \"require('fs').rmSync('.test-results/playwright.json',{force:true})\" && playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:roles": "tsx scripts/seed-roles.ts",
    "db:seed:sample": "tsx scripts/seed-sample.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-super-admin.ts",
    "admin:recover": "tsx scripts/admin-recover.ts",
    "guard:operational": "node scripts/guard-operational.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "check:all": "npm run lint && npm run typecheck && npm run guard:operational && npm run scan:secrets && npm test",
    "worker": "tsx scripts/worker.ts",
    "meta:check": "tsx scripts/meta-check.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
