# TE One — contoh konfigurasi. Salin ke .env (jangan di-commit) dan isi nilainya per lingkungan.
# Setiap lingkungan (development/staging/production) WAJIB memakai database dan rahasia berbeda.

# development | test | staging | production
APP_ENV=development

# URL publik aplikasi (dipakai untuk pemeriksaan Origin/CSRF dan penanda cookie Secure).
APP_BASE_URL=http://localhost:3000

# Koneksi runtime: role `teone_app` (tanpa hak DDL; tanpa UPDATE/DELETE pada audit_log).
DATABASE_URL=postgres://teone_app:GANTI_PASSWORD_APP@localhost:5432/teone_dev
# Koneksi migrasi: role `teone_owner` (hanya dipakai skrip migrasi/CLI admin, bukan server web).
DATABASE_MIGRATION_URL=postgres://teone_owner:GANTI_PASSWORD_OWNER@localhost:5432/teone_dev

# Kunci enkripsi rahasia tersimpan (TOTP). 32 byte base64. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kelola TERPISAH dari database. Kehilangan kunci = semua TOTP harus di-reset.
APP_ENCRYPTION_KEY=

# true bila di belakang reverse proxy tepercaya (membaca IP dari X-Forwarded-For).
TRUST_PROXY=false
