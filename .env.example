# TE One — contoh konfigurasi. Salin ke .env (jangan di-commit) dan isi nilainya per lingkungan.
# Setiap lingkungan (development/staging/production) WAJIB memakai database dan rahasia berbeda.

# development | test | staging | production
APP_ENV=development

# URL publik aplikasi (dipakai untuk pemeriksaan Origin/CSRF dan penanda cookie Secure).
APP_BASE_URL=http://localhost:3000

# Koneksi runtime: role `teone_app` (tanpa hak DDL; tanpa UPDATE/DELETE pada audit_log).
DATABASE_URL=postgres://teone_app:GANTI_PASSWORD_APP@localhost:5432/teone_dev
# Koneksi migrasi: role `teone_owner` (hanya dipakai skrip migrasi/CLI admin, bukan server web).
DATABASE_MIGRATION_URL=postgres://teone_owner:GANTI_PASSWORD_OWNER@localhost:5432/teone_dev

# Kunci enkripsi rahasia tersimpan (TOTP). 32 byte base64. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kelola TERPISAH dari database. Kehilangan kunci = semua TOTP harus di-reset.
APP_ENCRYPTION_KEY=

# true bila di belakang reverse proxy tepercaya (membaca IP dari X-Forwarded-For).
TRUST_PROXY=false

# ── Tahap 2: Meta WhatsApp Cloud API (aplikasi Meta MILIK TE One — BUKAN aplikasi Halo AI) ──
# Isi per lingkungan dari secret store. Kosong = webhook menolak (fail-closed). JANGAN di-commit.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
# ID aplikasi Meta milik TE One (bukan rahasia). Opsional, tetapi TANPA ini langganan webhook tidak dapat dikonfirmasi sebagai aplikasi yang benar.
META_APP_ID=
# Versi Graph API & basis URL (ubah basis URL hanya untuk mock/uji; nilai bawaan = Meta asli).
META_GRAPH_API_VERSION=v23.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_HTTP_TIMEOUT_MS=10000
# Penyimpanan media privat (bukan di folder publik) dan mode worker.
MEDIA_DIR=.data/media
WORKER_INLINE=true
# Tahap 3: jeda (ms) job AI SIMULASI; hanya untuk uji. Flag `ai_simulation` tidak pernah menyala di production.
AI_SIM_DELAY_MS=0
